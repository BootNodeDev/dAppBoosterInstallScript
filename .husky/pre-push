set -e

pnpm lint
pnpm typecheck
pnpm test

. "$(dirname "$0")/gitleaks.sh"

# Backstop: scan the outgoing commit range for each ref git feeds us on stdin
# (<local ref> <local sha> <remote ref> <remote sha>). Catches secrets committed
# while the pre-commit hook was bypassed. rc is tracked explicitly so every ref is
# scanned and a leak in any of them fails the push, independent of the caller's set -e.
z=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z" ] && continue
  # An unknown remote sha (new branch, or a force-push over commits we never fetched) makes
  # "$remote_sha..$local_sha" unresolvable, and gitleaks reports that as 0 commits and success.
  # Fall back to everything not already on a remote-tracking ref so the scan cannot pass empty.
  if [ "$remote_sha" = "$z" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  gitleaks git --redact --verbose --log-opts="$range" . || rc=1
done
exit "$rc"
